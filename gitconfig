[init]
  	defaultBranch = main
[color]
	ui = auto
[commit]
	gpgSign = true
[core]
	excludesFile = ~/.gitignore
	editor = vim
[alias]
	ignored = !git ls-files -v | grep "^[[:lower:]]"
	amend = commit -S --amend
	cm = commit -S -m
	commit = commit -S 
	cherry-pick = cherry-pick -S
[rebase]
	autosquash = true
[include]
	path = ~/.gitconfig.local
[diff]
	colorMoved = zebra
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
