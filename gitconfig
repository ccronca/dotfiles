[init]
  	defaultBranch = main
[color]
	ui = auto
[commit]
	gpgSign = true
[core]
	excludesFile = ~/.gitignore
	editor = vim
[alias]
	ignored = !git ls-files -v | grep "^[[:lower:]]"
	amend = commit -S --amend
	cm = commit -S -m
	commit = commit -S 
	cherry-pick = cherry-pick -S
[rebase]
	autosquash = true
[include]
	path = ~/.gitconfig.local
[diff]
	colorMoved = zebra