{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@tarquinen/opencode-dcp",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "compaction": {
    "auto": true
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "mcp-obsidian-myjournal": {
        "type": "local",
        "command": ["uvx", "mcp-obsidian"],
        "environment": {
          "OBSIDIAN_API_KEY": "{env:OBSIDIAN_MYJOURNAL_API_KEY}",
          "OBSIDIAN_HOST": "127.0.0.1",
          "OBSIDIAN_PORT": "27124"
        }
      }
    }
  }
}
