# OpenCode - Dotfiles .gitignore
# Allowlist approach: ignore everything by default, then explicitly allow what we want to track

# Ignore everything
*

# Allow specific config files
!.gitignore
!opencode.jsonc
!dcp.jsonc
!AGENTS.md

# Allow agents directory and its contents
!agents/
!agents/*

# Allow commands directory and its contents
!commands/
!commands/*

# Allow plugins directory and its contents
!plugins/
!plugins/*

# skills/ - NOT tracked; managed by plugins (caveman, superpowers, etc.)
