# Claude Code - Dotfiles .gitignore
# Allowlist approach: ignore everything by default, then explicitly allow what we want to track

# Ignore everything
*

# Allow specific files and directories
!.gitignore
!CLAUDE.md
!settings.json
!statusline-command.sh

# Allow agents directory and its contents
!agents/
!agents/*

# Allow commands directory and its contents
!commands/
!commands/*

# Allow hooks directory and its contents
!hooks/
!hooks/*
# But ignore Python cache
hooks/__pycache__/

# Allow plugins directory and its contents (optional)
!plugins/
!plugins/*

# Allow skills directory and its contents
!skills/
!skills/*/
!skills/*/**
