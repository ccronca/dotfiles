{
  "cleanupPeriodDays": 90,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "OTEL_SDK_DISABLED": "true",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-4-6",
    "ENABLE_PROMPT_CACHING_1H": "true"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Skill(Journaling)",
      "Bash(jira issue view:*)",
      "Bash(jira issue list:*)",
      "Bash(gcalcli agenda:*)",
      "Bash(gcalcli calw:*)",
      "Bash(gcalcli calm:*)",
      "Bash(gcalcli search:*)",
      "Bash(gcalcli list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tail:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run python -m ruff check:*)",
      "Bash(curl -s -X POST http://127.0.0.1:8787/rewrite:*)",
      "Read(~/.claude/commands/.internal/fetch-mr-reviews.md)",
      "Read(~/.claude/**)",
      "SlashCommand(/jira-journal:*)",
      "Skill(claude-docs)",
      "Bash(jira me)",
      "mcp__mcp-obsidian-myjournal__obsidian_list_files_in_dir",
      "mcp__mcp-obsidian-myjournal__obsidian_append_content",
      "mcp__mcp-obsidian-myjournal__obsidian_list_files_in_vault",
      "mcp__mcp-obsidian-myjournal__obsidian_batch_get_file_contents",
      "mcp__mcp-obsidian-myjournal__obsidian_get_file_contents",
      "mcp__mcp-obsidian-myjournal__obsidian_get_periodic_note",
      "mcp__Atlassian-Rovo-MCP__atlassianUserInfo",
      "mcp__Atlassian-Rovo-MCP__fetch",
      "mcp__Atlassian-Rovo-MCP__getAccessibleAtlassianResources",
      "mcp__Atlassian-Rovo-MCP__getCompassComponent",
      "mcp__Atlassian-Rovo-MCP__getCompassComponents",
      "mcp__Atlassian-Rovo-MCP__getCompassCustomFieldDefinitions",
      "mcp__Atlassian-Rovo-MCP__getConfluenceCommentChildren",
      "mcp__Atlassian-Rovo-MCP__getConfluencePage",
      "mcp__Atlassian-Rovo-MCP__getConfluencePageDescendants",
      "mcp__Atlassian-Rovo-MCP__getConfluencePageFooterComments",
      "mcp__Atlassian-Rovo-MCP__getConfluencePageInlineComments",
      "mcp__Atlassian-Rovo-MCP__getConfluenceSpaces",
      "mcp__Atlassian-Rovo-MCP__getIssueLinkTypes",
      "mcp__Atlassian-Rovo-MCP__getJiraIssue",
      "mcp__Atlassian-Rovo-MCP__getJiraIssueRemoteIssueLinks",
      "mcp__Atlassian-Rovo-MCP__getJiraIssueTypeMetaWithFields",
      "mcp__Atlassian-Rovo-MCP__getJiraProjectIssueTypesMetadata",
      "mcp__Atlassian-Rovo-MCP__getPagesInConfluenceSpace",
      "mcp__Atlassian-Rovo-MCP__getTeamworkGraphContext",
      "mcp__Atlassian-Rovo-MCP__getTeamworkGraphObject",
      "mcp__Atlassian-Rovo-MCP__getTransitionsForJiraIssue",
      "mcp__Atlassian-Rovo-MCP__getVisibleJiraProjects",
      "mcp__Atlassian-Rovo-MCP__lookupJiraAccountId",
      "mcp__Atlassian-Rovo-MCP__search",
      "mcp__Atlassian-Rovo-MCP__searchConfluenceUsingCql",
      "mcp__Atlassian-Rovo-MCP__searchJiraIssuesUsingJql",
      "mcp__codebase-memory-mcp__list_projects",
      "mcp__codebase-memory-mcp__index_status",
      "mcp__codebase-memory-mcp__get_graph_schema",
      "mcp__codebase-memory-mcp__search_graph",
      "mcp__codebase-memory-mcp__search_code",
      "mcp__codebase-memory-mcp__trace_path",
      "mcp__codebase-memory-mcp__detect_changes",
      "mcp__codebase-memory-mcp__query_graph",
      "mcp__codebase-memory-mcp__get_code_snippet",
      "mcp__codebase-memory-mcp__get_architecture"
    ],
    "deny": [
      "Bash(git subtree *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -D:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(yarn add:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(jira issue create:*)",
      "Bash(jira issue edit:*)",
      "Bash(glab mr create:*)",
      "Bash(gh pr create:*)"
    ]
  },
  "model": "claude-opus-4-6[1m]",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-events-simple.py --event-type SessionStart"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/bin/node-22\" \"$HOME/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-events-simple.py --event-type Stop"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-completion.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-events-simple.py --event-type SessionEnd"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-journal-on-exit.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-events-simple.py --event-type UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/rewrite-prompt.py",
            "statusMessage": "Improving prompt..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/bin/node-22\" \"$HOME/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-events-simple.py --event-type PreCompact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read|Search",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "opus",
  "teammateMode": "tmux"
}
